# ZERO public demo configuration
ZERO_MODE=paper
ZERO_LOG_LEVEL=info
ZERO_JOURNAL_PATH=/data/decisions.jsonl
ZERO_HYPERLIQUID_LIVE_PRICES=true

# Optional hosted-compatible ZERO Intelligence API reference surface.
# Use disposable demo values only; production key issuance belongs to the
# hosted ZERO Intelligence service, not to the local paper runtime.
ZERO_INTELLIGENCE_API_TOKEN=
ZERO_INTELLIGENCE_API_PLAN=free
ZERO_INTELLIGENCE_API_ACCOUNT_ID=acct_railway
ZERO_INTELLIGENCE_WEBHOOK_SIGNING_KEY=
ZERO_INTELLIGENCE_STORE_PATH=/data/zero/intelligence.jsonl
